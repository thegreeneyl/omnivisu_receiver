# --- Build artifacts ---
obj/
# Keep bin/data (runtime assets), drop everything else generated into bin/
# (including the macOS .app bundle build product)
bin/*
!bin/data/

# --- Machine-local runtime config (NEVER overwritten by git) ---
# Each machine owns its config.json/grading.json; the repo ships the tracked
# *.default.json versions, which update-from-git.sh copies into place on a
# fresh checkout. Use backup-config.sh to push a machine's live values into
# the tracked machine-config/<hostname>/ folder for backup.
bin/data/config.json
bin/data/grading.json

# Recorded clips written by the app at runtime
bin/data/recordings/

# Common shared libs that get copied into bin/ at build time
# (these come from the openFrameworks distribution, not from this repo)
*.so
*.so.*
*.dll
*.dylib

# Build product names (defensive, in case the binary is dropped at repo root)
/omnivisu_receiver
/omnivisu_receiver_debug
*.app/

# --- Editor / OS ---
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.idea/
.vs/
*.user

# Xcode
xcuserdata/
*.xcuserstate

# --- Misc ---
*.log
core
core.*
